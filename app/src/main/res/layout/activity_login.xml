<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.home.HomeFragment"
    >

    <FrameLayout
        android:id="@+id/login_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EFEBE0">

            <TextView
                android:id="@+id/tv_login_title_booking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110px"
                android:layout_marginTop="250px"
                android:fontFamily="@font/pretendard_extrabold"
                android:text="북킹,"
                android:textColor="@color/black"
                android:textSize="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_login_title_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110px"
                android:layout_marginTop="-5dp"
                android:fontFamily="@font/pretendard_bold"
                android:lineHeight="60dp"
                android:text="환영합니다!"
                android:textColor="@color/black"
                android:textSize="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_title_booking" />

            <TextView
                android:id="@+id/tv_login_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110px"
                android:layout_marginTop="150px"
                android:fontFamily="@font/pretendard_medium"
                android:lineHeight="60dp"
                android:text="email"
                android:textSize="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_title_welcome" />

            <EditText
                android:id="@+id/et_login_email"
                android:layout_width="300dp"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ic_login_round_box"
                android:paddingStart="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_email" />

            <TextView
                android:id="@+id/tv_login_pw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="110px"
                android:layout_marginTop="100px"
                android:fontFamily="@font/pretendard_medium"
                android:lineHeight="60dp"
                android:text="password"
                android:textSize="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_login_email" />

            <EditText
                android:id="@+id/et_login_pw"
                android:layout_width="300dp"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ic_login_round_box"
                android:paddingStart="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_pw" />

            <TextView
                android:id="@+id/tv_login_login"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:background="@drawable/ic_login_round_box"
                android:backgroundTint="#555555"
                android:fontFamily="@font/pretendard_semibold"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="로그인"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_login_pw" />

            <TextView
                android:id="@+id/btn_google_sign_in"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/ic_login_round_box"
                android:fontFamily="@font/pretendard_semibold"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="구글로 로그인"
                android:paddingStart="10dp"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_login" />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_google_logo"
                app:layout_constraintStart_toStartOf="@id/btn_google_sign_in"
                app:layout_constraintTop_toTopOf="@id/btn_google_sign_in"
                app:layout_constraintBottom_toBottomOf="@id/btn_google_sign_in"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/tv_login_signup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="100px"
                android:fontFamily="@font/pretendard_semibold"
                android:lineHeight="60dp"
                android:text="회원가입"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>