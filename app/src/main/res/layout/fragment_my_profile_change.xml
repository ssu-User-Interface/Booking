<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBFAF7">

    <LinearLayout
        android:id="@+id/fragment_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back_arrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tv_my_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="8"
                android:layout_marginStart="-10dp"
                android:fontFamily="@font/pretendard_regular"
                android:gravity="center_horizontal"
                android:text="프로필 수정"
                android:textColor="@color/black"
                android:textSize="17sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="right"
                android:layout_weight="1" />

        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="330dp"
            android:layout_height="2px"
            android:layout_marginStart="13dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp"
            android:background="@color/black" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_my_page_profile_change_profile"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_mypage_profile"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_my_page_profile_change_icon"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_profile_change_profile"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_profile_change_profile"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_profile_change_profile"
        app:layout_constraintEnd_toEndOf="@id/iv_my_page_profile_change_profile"/>

    <ImageView
        android:id="@+id/iv_my_page_nick_name_change"
        android:layout_width="250dp"
        android:layout_height="70dp"
        android:src="@drawable/img_mypage_nick_name_change"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/iv_my_page_profile_change_profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_nick_name_change"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_nick_name_change"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_nick_name_change"
        app:layout_constraintEnd_toEndOf="@id/iv_my_page_nick_name_change"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_my_page_nick_name_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="닉네임 수정"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_semibold"
            android:background="@null"
            android:textColorHint="#606060"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/iv_my_page_nick_name_change_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_my_page_profile_change_nick_name_check"
            android:layout_gravity="center"
            android:layout_marginStart="110dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>