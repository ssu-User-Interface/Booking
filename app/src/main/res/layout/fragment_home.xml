<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBFAF7"
    tools:context=".presentation.home.HomeFragment">

    <TextView
        android:id="@+id/tv_home_title_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="90px"
        android:layout_marginTop="80px"
        android:fontFamily="@font/pretendard_extrabold"
        android:textColor="#000000"
        android:textSize="33dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_home_title_hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="90px"
        android:fontFamily="@font/pretendard_regular"
        android:lineHeight="60dp"
        android:text="오늘은 무슨 책을 읽으셨나요?"
        android:textSize="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_title_name" />

    <EditText
        android:id="@+id/et_home_search"
        android:layout_width="310dp"
        android:layout_height="40dp"
        android:paddingStart="15dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/drawer_little_corenr_outline"
        android:hint="검색할 책을 입력하세요"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_title_hello" />

    <ImageView
        android:id="@+id/iv_home_search_ic"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="15dp"
        android:src="@drawable/ic_home_search"
        app:layout_constraintBottom_toBottomOf="@id/et_home_search"
        app:layout_constraintEnd_toEndOf="@id/et_home_search"
        app:layout_constraintTop_toTopOf="@id/et_home_search" />

    <View
        android:id="@+id/view_home_first_widget_bg"
        android:layout_width="310dp"
        android:layout_height="170dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/ic_home_fisrt_widget"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_home_search" />

    <ImageView
        android:id="@+id/iv_home_book"
        android:layout_width="80dp"
        android:layout_height="115.8dp"
        android:layout_marginStart="25dp"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        app:layout_constraintStart_toStartOf="@id/view_home_first_widget_bg"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/tv_home_first_widget_book_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:maxLength="9"
        android:textSize="18sp"
        android:textColor="#FFFF"
        android:text="안녕하세요"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg"
        app:layout_constraintStart_toEndOf="@id/iv_home_book"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toStartOf="@id/view_home_first_widget_right_bg"
        android:visibility="visible"/>


    <View
        android:id="@+id/view_home_line"
        android:layout_width="120dp"
        android:layout_height="3px"
        android:layout_marginTop="5dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_home_first_widget_book_title"
        app:layout_constraintStart_toEndOf="@id/iv_home_book"
        app:layout_constraintEnd_toStartOf="@id/view_home_first_widget_right_bg"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/tv_home_first_widget_reading_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/pretendard_light"
        android:textColor="#FFFF"
        android:textSize="12sp"
        android:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/iv_home_book"
        app:layout_constraintTop_toBottomOf="@id/view_home_line" />

    <TextView
        android:id="@+id/tv_home_first_widget_reading_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_light"
        android:textSize="12sp"
        android:textColor="#FFFF"
        app:layout_constraintTop_toBottomOf="@id/tv_home_first_widget_reading_period"
        app:layout_constraintStart_toEndOf="@id/iv_home_book"
        android:layout_marginStart="15dp"
        android:visibility="visible"/>

    <ProgressBar
        android:id="@+id/prg"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="7dp"
        android:max="1000"
        android:progress="300"
        android:progressDrawable="@drawable/progressbar_color"
        app:layout_constraintTop_toBottomOf="@id/tv_home_first_widget_reading_page"
        app:layout_constraintStart_toEndOf="@id/iv_home_book"
        app:layout_constraintEnd_toStartOf="@id/view_home_first_widget_right_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="17dp"
        android:visibility="visible"/>

    <View
        android:id="@+id/view_home_first_widget_right_bg"
        android:layout_width="60dp"
        android:layout_height="170dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ic_home_fisrt_widget_right"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg" />

    <View
        android:id="@+id/view_home_first_widget_right_to_timer"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/ic_home_move_to_timer"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        app:layout_constraintStart_toStartOf="@id/view_home_first_widget_right_bg"
        app:layout_constraintEnd_toEndOf="@id/view_home_first_widget_right_bg"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg"
        android:visibility="visible"/>

    <ImageView
        android:id="@+id/iv_home_book_ic"
        android:layout_width="90dp"
        android:layout_height="95dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/ic_home_book"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        app:layout_constraintStart_toStartOf="@id/view_home_first_widget_bg"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg" />

    <TextView
        android:id="@+id/tv_home_first_widget_no_book"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:text="어떤 책을 \n읽을까요?"
        android:textSize="25sp"
        android:textColor="#FFFF"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toStartOf="@id/view_home_first_widget_right_bg"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg"
        app:layout_constraintStart_toEndOf="@id/iv_home_book_ic"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        android:visibility="gone"/>

    <View
        android:id="@+id/view_home_first_widget_right_add_book"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/ic_home_add_book"
        app:layout_constraintBottom_toBottomOf="@id/view_home_first_widget_bg"
        app:layout_constraintStart_toStartOf="@id/view_home_first_widget_right_bg"
        app:layout_constraintEnd_toEndOf="@id/view_home_first_widget_right_bg"
        app:layout_constraintTop_toTopOf="@id/view_home_first_widget_bg"
        android:visibility="gone"/>


    <View
        android:id="@+id/view_home_d_day_widget_bg"
        android:layout_width="310dp"
        android:layout_height="110dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/ic_home_d_day_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_home_first_widget_bg" />

    <TextView
        android:id="@+id/tv_home_d_day_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="@id/view_home_d_day_widget_bg"
        app:layout_constraintStart_toStartOf="@id/view_home_d_day_widget_bg"
        app:layout_constraintEnd_toEndOf="@id/view_home_d_day_widget_bg"
        android:text="총 독서 기간"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/pretendard_semibold"
        />

    <TextView
        android:id="@+id/tv_home_d_day_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_home_d_day_description"
        app:layout_constraintStart_toStartOf="@id/view_home_d_day_widget_bg"
        app:layout_constraintEnd_toEndOf="@id/view_home_d_day_widget_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_home_d_day_widget_bg"
        android:layout_marginBottom="17dp"
        android:textColor="@color/white"
        android:textSize="55sp"
        android:fontFamily="@font/pretendard_bold"
        />

    <View
        android:id="@+id/view_home_total_time_widget_bg"
        android:layout_width="310dp"
        android:layout_height="110dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/ic_home_total_time_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_home_d_day_widget_bg" />

    <TextView
        android:id="@+id/tv_home_total_time_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="@id/view_home_total_time_widget_bg"
        app:layout_constraintStart_toStartOf="@id/view_home_total_time_widget_bg"
        app:layout_constraintEnd_toEndOf="@id/view_home_total_time_widget_bg"
        android:text="총 독서 시간"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/pretendard_semibold"
        />

    <TextView
        android:id="@+id/tv_home_total_time_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_home_total_time_description"
        app:layout_constraintStart_toStartOf="@id/view_home_total_time_widget_bg"
        app:layout_constraintEnd_toEndOf="@id/view_home_total_time_widget_bg"
        app:layout_constraintBottom_toBottomOf="@id/view_home_total_time_widget_bg"
        android:layout_marginBottom="17dp"
        android:textColor="@color/white"
        android:textSize="55sp"
        android:fontFamily="@font/pretendard_bold"
        />

</androidx.constraintlayout.widget.ConstraintLayout>