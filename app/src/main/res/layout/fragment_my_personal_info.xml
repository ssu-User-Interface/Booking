<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBFAF7">

    <LinearLayout
        android:id="@+id/fragment_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back_arrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/tv_my_page_personal_info_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="8"
                android:layout_marginStart="-10dp"
                android:fontFamily="@font/pretendard_regular"
                android:gravity="center_horizontal"
                android:text="개인정보 처리 방침"
                android:textColor="@color/black"
                android:textSize="17sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="right"
                android:layout_weight="1" />

        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="330dp"
            android:layout_height="2px"
            android:layout_marginStart="13dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp"
            android:background="@color/black" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_top"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="북킹 개인정보 처리방침\n"
                android:paddingStart="15dp"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_semibold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_title_2"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="1. 개인정보 수집 항목 및 목적\n"
                android:paddingStart="15dp"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_semibold" />

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_detail_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:layout_marginTop="5dp"
                android:text="이메일 주소: 회원 식별 및 계정 관리를 위한 필수 정보입니다. 또한, 비밀번호 재설정 요청 및 중요 공지 전달 시 사용됩니다.\n비밀번호: 계정 보안을 위해 필수적으로 수집하며 암호화하여 안전하게 보관합니다.\n프로필 사진 (선택 항목): 사용자 프로필을 개인화하는 용도로 사용되며, 다른 사용자가 사용자 계정을 쉽게 인식할 수 있도록 돕습니다.\n닉네임: 앱 내에서 다른 사용자와의 소통 및 사용자 식별을 위해 사용됩니다." />

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_title_3"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="2. 개인정보의 이용 목적\n"
                android:paddingStart="15dp"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_semibold"
                android:layout_marginTop="9dp"/>

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_detail_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:layout_marginTop="5dp"
                android:text="수집된 정보는 다음과 같은 목적으로 사용됩니다.\n서비스 제공 및 계정 관리: 서비스 제공, 회원 확인, 계정 복구, 비밀번호 재설정 등.\n개인화 서비스: 사용자가 프로필을 개인화할 수 있도록 프로필 사진과 닉네임 정보를 활용.\n고객 지원 및 서비스 개선: 사용자 문의에 응대하고 서비스 품질을 개선하기 위한 참고 자료로 사용."/>

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_title_4"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="3. 개인정보 제3자 제공\n"
                android:paddingStart="15dp"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_semibold"
                android:layout_marginTop="9dp"/>

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_detail_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:layout_marginTop="5dp"
                android:text="북킹 앱은 원칙적으로 수집된 개인정보를 제3자에게 제공하지 않습니다. 다만, 법령에 따라 요청이 있을 경우 예외적으로 제공할 수 있습니다."/>

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_title_5"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="4. 개인정보의 보관 및 파기\n"
                android:paddingStart="15dp"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_semibold"
                android:layout_marginTop="9dp"/>

            <TextView
                android:id="@+id/tv_my_page_personal_info_content_detail_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:layout_marginTop="5dp"
                android:text="보관 기간: 회원 탈퇴 시까지 보관하며, 법령에 따라 일정 기간 보관해야 할 필요가 있을 경우 해당 법령을 준수합니다.\n파기 절차 및 방법: 회원 탈퇴 또는 목적 달성 후 지체 없이 안전한 방법으로 파기합니다."/>
        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>