<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBFAF7">

    <LinearLayout
        android:id="@+id/fragment_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_mypage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/pretendard_bold"
                android:paddingStart="20dp"
                android:text="My Page"
                android:textColor="@color/black"
                android:textSize="20sp" />

        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="330dp"
            android:layout_height="2px"
            android:layout_marginStart="13dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp"
            android:background="@color/black" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_my_page_profile"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_mypage_profile"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/fragment_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/img_mypage_profile_sample"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_profile"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_profile"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_profile"
        app:layout_constraintEnd_toEndOf="@id/iv_my_page_profile"/>

    <TextView
        android:id="@+id/iv_my_page_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이수민"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_bold"
        android:layout_marginTop="10dp"
        android:layout_marginStart="42dp"
        app:layout_constraintTop_toBottomOf="@id/iv_my_page_profile"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_profile"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="님"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_regular"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_name"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_name"
        app:layout_constraintStart_toEndOf="@id/iv_my_page_name"/>

    <ImageView
        android:id="@+id/iv_my_page_profile_change"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:src="@drawable/img_mypage_bg"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/iv_my_page_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_profile_change"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_profile_change"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_profile_change"
        app:layout_constraintEnd_toEndOf="@id/iv_my_page_profile_change"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_my_page_profile_change_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_mypage_profile_change_icon"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tv_my_page_profile_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="프로필 수정"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_semibold"
            android:textColor="#606060"
            android:layout_marginStart="12dp"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/iv_my_page_profile_change_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_mypage_arrow"
            android:layout_gravity="center"
            android:layout_marginStart="130dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_my_page_personal_info"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:src="@drawable/img_mypage_bg"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/iv_my_page_profile_change"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_personal_info"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_personal_info"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_personal_info"
        app:layout_constraintEnd_toEndOf="@id/iv_my_page_personal_info"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_my_page_personal_info_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_my_page_personal_info"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tv_my_page_personal_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="개인정보 처리방침"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_semibold"
            android:textColor="#606060"
            android:layout_marginStart="12dp"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/iv_my_page_personal_info_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_mypage_arrow"
            android:layout_gravity="center"
            android:layout_marginStart="82dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_my_page_logout"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:src="@drawable/img_mypage_bg"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/iv_my_page_personal_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/iv_my_page_logout"
        app:layout_constraintBottom_toBottomOf="@id/iv_my_page_logout"
        app:layout_constraintStart_toStartOf="@id/iv_my_page_logout"
        app:layout_constraintEnd_toEndOf="@id/iv_my_page_logout"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_my_page_logout_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_mypage_logout_icon"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tv_my_page_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그아웃"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_semibold"
            android:textColor="#606060"
            android:layout_marginStart="12dp"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/iv_my_page_logout_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/img_mypage_arrow"
            android:layout_gravity="center"
            android:layout_marginStart="148dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/bt_my_page_account_del"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:text="계정 탈퇴"
        android:textSize="14sp"
        android:fontFamily="@font/pretendard_regular"
        android:background="@drawable/img_mypage_account_del"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/iv_my_page_logout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>